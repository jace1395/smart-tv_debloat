# ==========================================
# Smart TV Debloat & Automation Suite
# Environment Configuration Template
# ==========================================

# Primary Android TV Device (ADB over Wi-Fi / Ethernet)
# Replace with your TV's local LAN IP address (Find via TV Settings -> Network or router client list)
TV_HOST=192.168.1.50
TV_PORT=5555
STOCK_LAUNCHER=none

# Secondary TV Devices (Optional)
REDMI_TV_HOST=192.168.1.51
BRAVIA_TV_HOST=192.168.1.52

# Local Android SDK Toolchain Path (Optional override)
# ANDROID_HOME=C:\Users\<YourUsername>\AppData\Local\Android\Sdk
# JAVA_HOME=C:\Program Files\Android\Android Studio\jbr
