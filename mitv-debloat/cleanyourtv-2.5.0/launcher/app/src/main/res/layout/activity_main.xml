<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:alpha="0" />

    <!-- Top vignette scrim to guarantee contrast over bright/white wallpapers like Spider-Man -->
    <View
        android:id="@+id/topVignette"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@drawable/top_vignette"
        android:importantForAccessibility="no" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend): in the free space under the clock,
         shown only from shortly before a weekend's first session until the race is over. Updated once a
         minute with the clock, never animated. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="56dp"
        android:layout_marginTop="86dp"
        android:background="@drawable/sports_panel_bg"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/sportsTabRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="3dp">

            <!-- A short kerb-red bar, the panel's one accent. -->
            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/tabFootball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/sports_tab_bg"
                android:singleLine="true"
                android:text="ISL FOOTBALL"
                android:textColor="#FFFFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.2"
                android:shadowColor="#D9000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@+id/tabF1"
                android:nextFocusDown="@+id/btnSportWatch"
                android:nextFocusUp="@+id/clock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="|"
                android:textColor="#4DFFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabF1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/sports_tab_bg"
                android:singleLine="true"
                android:text="F1"
                android:textColor="#70FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.2"
                android:shadowColor="#D9000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@+id/tabFootball"
                android:nextFocusRight="@+id/btnInputs"
                android:nextFocusDown="@+id/btnSportWatch"
                android:nextFocusUp="@+id/clock" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceKicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.18"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="-0.01"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="10"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceTopDrivers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.05"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/raceSessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.1"
                android:shadowColor="#D9000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/btnSportWatch"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:background="@drawable/pill_bg"
                android:singleLine="true"
                android:text="▶ STREAM ISL"
                android:textColor="@drawable/pill_text"
                android:textSize="10.5sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.08"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/tabFootball"
                android:nextFocusDown="@+id/grid" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@font/outfit_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- No clipping down to the pills: with advanced effects a focused pill scales up past its row. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:letterSpacing="0.22"
                    android:shadowColor="#D9000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm:ss"
                        android:format24Hour="HH:mm:ss"
                        android:textColor="#FFFFFFFF"
                        android:textSize="46sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="-0.04"
                        android:shadowColor="#D9000000"
                        android:shadowDx="0"
                        android:shadowDy="3"
                        android:shadowRadius="10"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.08"
                        android:shadowColor="#D9000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textAllCaps="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.02"
                            android:shadowColor="#D9000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="8"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="@bool/date_single_line"
                            android:maxLines="2"
                            android:lineSpacingExtra="6dp"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format_home"
                            android:format24Hour="@string/date_format_home"
                            android:textColor="#A6FFFFFF"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.03"
                            android:shadowColor="#D9000000"
                            android:shadowDx="0"
                            android:shadowDy="2"
                            android:shadowRadius="8"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Shown only when show_stats is on. Outside leftBlock, so the top buttons stay level with the clock
                 row; gone, it takes no space. -->
            <TextView
                android:id="@+id/stats"
                android:layout_width="0dp"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:layout_alignEnd="@id/leftBlock"
                android:gravity="left"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
